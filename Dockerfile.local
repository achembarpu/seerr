FROM alpine:3.23 AS smart-search-runtime
ARG TARGETPLATFORM
RUN apk add --no-cache git cmake make g++ linux-headers vulkan-loader-dev vulkan-headers shaderc spirv-headers
RUN git clone --filter=blob:none --no-checkout https://github.com/ggml-org/llama.cpp.git /llama && \
  cd /llama && git checkout 32bdc3a89e6528d3e419024c833c5dabf32c7541 && \
  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
    -DGGML_NATIVE=OFF -DGGML_OPENMP=OFF -DGGML_VULKAN=ON -DLLAMA_CURL=OFF -DLLAMA_OPENSSL=OFF -DLLAMA_BUILD_TESTS=OFF && \
  cmake --build build --target llama-server -j 2 && strip build/bin/llama-server

FROM node:22.23.5-alpine3.23@sha256:6868d4695b947ee120bffaa463fecd68cde370d7bfec92955e7c8ac576b4f475

ARG TARGETPLATFORM
RUN apk add --no-cache libstdc++ vulkan-loader mesa-vulkan-ati && \
  case "${TARGETPLATFORM}" in linux/amd64) apk add --no-cache mesa-vulkan-intel ;; linux/arm64) apk add --no-cache mesa-vulkan-asahi ;; esac
COPY --from=smart-search-runtime /llama/build/bin/llama-server /usr/local/bin/llama-server

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

COPY . /app
WORKDIR /app

RUN pnpm install

CMD pnpm dev
